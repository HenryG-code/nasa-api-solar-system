// Cloudflare Workers config: serves this repository as a static site.
// The name must match the Worker in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasa-api-solar-system",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  },
  // Enables preview deployments: Cloudflare runs `wrangler preview` for
  // non-production branches (pull requests). Assets and compatibility
  // settings are inherited from the top level, so the block can be empty.
  "previews": {}
}
